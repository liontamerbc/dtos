#!/usr/bin/env bash
# Triggered by pywal after every run; refresh themes so everything follows the wallpaper.
set -euo pipefail

# Some desktop sessions drop /usr/sbin from PATH; add it so papirus-folders is found.
PATH="$PATH:/usr/sbin:/sbin"

CACHE="$HOME/.cache/wal"
WAL_JSON="$CACHE/colors.json"
WAL_GTK="$CACHE/colors-gtk.css"

# Sync all OpenRGB devices (Keyboard, RAM, Motherboard, Front Fans) to the pywal accent color
if [ -f "$WAL_JSON" ]; then
    python3 - "$WAL_JSON" <<'PY' >/dev/null 2>&1 || true
import colorsys, json, socket, sys
from pathlib import Path

wal_file = Path(sys.argv[1])
data = json.loads(wal_file.read_text())
colors = data.get("colors", {})
best_rgb = (255, 198, 0)
best_score = -1.0
for k in ("color1", "color2", "color3", "color4", "color5", "color6"):
    val = colors.get(k, "")
    if not val or not val.startswith("#") or len(val) < 7:
        continue
    h = val.lstrip("#")
    r, g, b = [int(h[i:i+2], 16) / 255.0 for i in (0, 2, 4)]
    hue, s, v = colorsys.rgb_to_hsv(r, g, b)
    score = s * (0.4 + 0.6 * v)
    if score > best_score:
        best_score = score
        s_b = min(1.0, s * 1.65) if s > 0.08 else s
        v_b = max(0.95, v)
        rb, gb, bb = [int(x * 255) for x in colorsys.hsv_to_rgb(hue, s_b, v_b)]
        best_rgb = (rb, gb, bb)

try:
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.sendto(b"PYWAL_SYNC", ("127.0.0.1", 54321))
    sock.close()
except Exception:
    pass

try:
    from openrgb import OpenRGBClient
    from openrgb.utils import RGBColor
    cli = OpenRGBClient()
    col = RGBColor(*best_rgb)
    for d in cli.devices:
        try:
            d.set_mode("Direct")
        except Exception:
            pass
        d.set_color(col)
except Exception:
    pass
PY
fi

# If dtos-original is active, keep classic DTOS app/terminal colors and only sync RGB
if [[ "$(readlink -f "$HOME/.config/qtile" 2>/dev/null || true)" == *"dtos-original"* ]]; then
    cat > "$CACHE/colors-alacritty.toml" <<'EOF'
