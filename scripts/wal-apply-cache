#!/usr/bin/env bash
# Re-apply pywal from cached wallpaper paths (Awesome/Qtile) for auto-sync.
set -euo pipefail

pick_wall() {
  if pgrep -x qtile >/dev/null 2>&1; then
    caches=("$HOME/.cache/wall_qtile" "$HOME/.cache/wall" "$HOME/.cache/wall_awesome")
  elif pgrep -x awesome >/dev/null 2>&1; then
    caches=("$HOME/.cache/wall_awesome" "$HOME/.cache/wall" "$HOME/.cache/wall_qtile")
  else
    mapfile -t caches < <(ls -1t "$HOME/.cache/wall_qtile" "$HOME/.cache/wall_awesome" "$HOME/.cache/wall" 2>/dev/null || true)
  fi

  for cache in "${caches[@]}"; do
    if [ -s "$cache" ]; then
      img="$(cat "$cache" 2>/dev/null || true)"
      [ -n "$img" ] && [ -f "$img" ] && { printf "%s\n" "$img"; return 0; }
    fi
  done

  if [ -d /usr/share/backgrounds/dtos-backgrounds ]; then
    find /usr/share/backgrounds/dtos-backgrounds -type f | head -n1
    return 0
  fi

  return 1
}

if ! command -v wal >/dev/null 2>&1; then
  exit 0
fi

wall_img="$(pick_wall || true)"
postrun="$HOME/.config/wal/postrun"

if [[ "$(readlink -f "$HOME/.config/qtile" 2>/dev/null || true)" == *"dtos-wallust"* ]] && command -v wallust >/dev/null 2>&1; then
  if [ -n "$wall_img" ] && [ -f "$wall_img" ]; then
    wallust run -d "$HOME/.config/profiles/dtos-wallust/wallust" -w -q "$wall_img" >/dev/null 2>&1 || true
    [ -x "$postrun" ] && "$postrun" >/dev/null 2>&1 || true
  fi
elif [ -n "$wall_img" ] && [ -f "$wall_img" ]; then
  set -- wal -n -q -i "$wall_img"
  [ -x "$postrun" ] && set -- "$@" -o "$postrun"
  "$@" >/dev/null 2>&1 || wal -n -q -R >/dev/null 2>&1 || true
else
  wal -n -q -R >/dev/null 2>&1 || true
fi

# Refresh Qtile widgets in-place if running (zero flicker)
if command -v qtile >/dev/null 2>&1; then
  qtile cmd-obj -o cmd -f fire_user_hook -a recolor_bar >/dev/null 2>&1 || true
fi
